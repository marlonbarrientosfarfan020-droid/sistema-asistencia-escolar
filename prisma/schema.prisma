generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Colegio {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique
  nombre        String
  nombreCorto   String   @default("")
  direccion     String   @default("")
  telefono      String   @default("")
  logo          String   @default("")
  estado        String   @default("ACTIVO") // "ACTIVO" | "SUSPENDIDO"
  fechaRegistro DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sistemaControl    SistemaControl?
  configuracion     Configuracion?
  usuarios          Usuario[]
  estudiantes       Estudiante[]
  turnos            Turno[]
  asistencias       Asistencia[]
  calendarios       CalendarioEscolar[]
  codigosFamiliares CodigoFamiliar[]
  historialReportes HistorialReporteAutomatico[]
  auditorias        Auditoria[]
  analisisIA        AnalisisIA[]
  systemHealthLogs  SystemHealthLog[]
  terminales        Terminal[]
  salidasExcepcionales SalidaExcepcional[]
  evidenciasFotograficas EvidenciaFotografica[]
  fotosActivas           FotoActivaEstudiante[]
  colasLimpiezaBlob      ColaLimpiezaBlob[]

  @@index([codigo])
  @@index([estado])
}

model Estudiante {
  id             Int      @id @default(autoincrement())
  colegioId      String   @default("SANTA_RITA_001")
  codigo         String   @unique
  dni            String   @unique
  nombres        String
  apellidos      String
  grado          String
  seccion        String
  nombreTutor    String   @default("")
  whatsapp       String   @default("")
  telegramChatId String   @default("")
  estado         Boolean  @default(true)
  createdAt      DateTime @default(now())

  colegio Colegio @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  turnoId Int?
  turno   Turno? @relation(fields: [turnoId], references: [id])

  codigoFamiliarId Int?
  codigoFamiliar   CodigoFamiliar? @relation(fields: [codigoFamiliarId], references: [id], onDelete: SetNull)

  asistencias       Asistencia[]
  alertasAsistencia AlertaAsistencia[]
  riesgoIA          RiesgoEstudianteIA?
  historialReportes HistorialReporteAutomatico[]
  biometriaFacial   BiometriaFacial?
  salidasExcepcionales SalidaExcepcional[]
  evidenciasFotograficas EvidenciaFotografica[]
  fotosActivas           FotoActivaEstudiante[]

  @@index([colegioId])
  @@index([turnoId])
  @@index([codigoFamiliarId])
  @@index([grado, seccion])
  @@index([estado])
}

model Turno {
  id                             Int      @id @default(autoincrement())
  colegioId                      String   @default("SANTA_RITA_001")
  nombre                         String
  horaEntrada                    String
  horaSalida                     String
  estado                         Boolean  @default(true)
  minutosAlertaInicial           Int      @default(5)
  margenAlertaMinutos            Int      @default(15)
  createdAt                      DateTime @default(now())
  margenEntradaAnticipadaMinutos Int      @default(60)
  margenSalidaAnticipadaMinutos  Int      @default(0)
  margenSalidaMinutos            Int      @default(60)

  colegio Colegio @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  estudiantes       Estudiante[]
  calendarioEscolar CalendarioEscolar[]
  asistencias       Asistencia[]
  fotosActivas      FotoActivaEstudiante[]

  @@unique([colegioId, nombre])
  @@index([colegioId])
}

model Asistencia {
  id            Int       @id @default(autoincrement())
  colegioId     String    @default("SANTA_RITA_001")
  fecha         DateTime  @default(now())
  fechaDia      String    @default("")
  horaEntrada   DateTime?
  horaSalida    DateTime?
  metodo        String
  estado        String    @default("PUNTUAL")
  estadoJornada String    @default("ABIERTA")
  estadoSalida  String?
  fotoEntrada   String?
  fotoSalida    String?
  fotoProtegida Boolean   @default(false)
  fotoEntradaProtegida Boolean @default(false)
  fotoSalidaProtegida Boolean  @default(false)
  fotoUrl       String?

  colegio Colegio @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  estudianteId Int
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  turnoId Int?
  turno   Turno? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  salidaExcepcional SalidaExcepcional?
  evidenciasFotograficas EvidenciaFotografica[]
  fotosActivas           FotoActivaEstudiante[]

  @@unique([estudianteId, fechaDia, turnoId])
  @@index([colegioId])
  @@index([colegioId, fechaDia])
  @@index([estudianteId, fechaDia])
  @@index([estudianteId])
  @@index([fecha])
  @@index([fechaDia])
  @@index([estado])
  @@index([estadoJornada])
  @@index([metodo])
  @@index([turnoId])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  colegioId String?  @default("SANTA_RITA_001")
  usuario   String   @unique
  password  String
  rol       String
  estado    Boolean  @default(true)
  createdAt DateTime @default(now())

  colegio           Colegio?        @relation(fields: [colegioId], references: [codigo], onDelete: SetNull)
  modulosPermitidos UsuarioModulo[]

  @@index([colegioId])
  @@index([estado])
  @@index([rol])
}

model UsuarioModulo {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  modulo    String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, modulo])
  @@index([usuarioId])
  @@index([modulo])
}

model Configuracion {
  id            Int      @id @default(autoincrement())
  colegioId     String   @unique @default("SANTA_RITA_001")
  nombreColegio String   @default("Santa Rita de Casia")
  logoUrl       String   @default("")
  direccion     String   @default("")
  telefono      String   @default("")
  correo        String   @default("")
  director      String   @default("")
  createdAt     DateTime @default(now())

  colegio Colegio @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  reporteTelegramActivo       Boolean   @default(false)
  horaReporteDiario           String    @default("21:00")
  telegramDirectorChatId      String    @default("")
  enviarReporteExcel          Boolean   @default(true)
  enviarReportePdf            Boolean   @default(true)
  ultimoReporteTelegramAt     DateTime?
  ultimoReporteTelegramEstado String    @default("")

  reporteDirectorActivo     Boolean   @default(false)
  frecuenciaReporteDirector String    @default("SEMANAL")
  diaReporteDirector        Int       @default(5)
  diaMesReporteDirector     Int       @default(28)
  horaReporteDirector       String    @default("18:00")
  ultimoReporteDirectorAt   DateTime?

  reportePadresActivo          Boolean   @default(false)
  frecuenciaReportePadres      String    @default("SEMANAL")
  diaReportePadres             Int       @default(5)
  diaMesReportePadres          Int       @default(28)
  horaReportePadres            String    @default("19:00")
  incluirRiesgoIAReportePadres Boolean   @default(true)
  ultimoReportePadresAt        DateTime?

  automatizacionesActivas         Boolean   @default(false)
  alertaIngresoPendienteActiva    Boolean   @default(true)
  minutosAlertaInicial            Int       @default(5)
  alertaTardanzaActiva            Boolean   @default(true)
  alertaAusenciaActiva            Boolean   @default(true)
  modoPruebaAlertas               Boolean   @default(true)
  telegramPruebaChatId            String    @default("")
  frecuenciaRevisionMinutos       Int       @default(5)
  ultimaEjecucionAutomatizaciones DateTime?
  ultimaEjecucionEstado           String    @default("")

  canalTelegramActivo             Boolean   @default(true)
  canalWhatsAppActivo             Boolean   @default(false)
  canalPortalWebActivo            Boolean   @default(true)

  @@index([colegioId])
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  colegioId String?  @default("SANTA_RITA_001")
  usuario   String
  rol       String
  accion    String
  modulo    String
  detalle   String
  createdAt DateTime @default(now())

  colegio Colegio? @relation(fields: [colegioId], references: [codigo], onDelete: SetNull)

  @@index([colegioId])
  @@index([createdAt])
  @@index([modulo])
  @@index([usuario])
}

model AlertaAsistencia {
  id           Int      @id @default(autoincrement())
  estudianteId Int
  fecha        String
  tipo         String
  createdAt    DateTime @default(now())

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, fecha, tipo])
  @@index([fecha])
  @@index([tipo])
}

model AnalisisIA {
  id        Int      @id @default(autoincrement())
  colegioId String?  @default("SANTA_RITA_001")
  tipo      String
  dni       String?
  resultado String
  createdAt DateTime @default(now())

  colegio Colegio? @relation(fields: [colegioId], references: [codigo], onDelete: SetNull)

  @@index([colegioId])
  @@index([tipo])
  @@index([dni])
  @@index([createdAt])
}

model RiesgoEstudianteIA {
  id            Int      @id @default(autoincrement())
  estudianteId  Int      @unique
  nivel         String   @default("BAJO")
  resumen       String   @default("")
  recomendacion String   @default("")
  porcentaje    Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([nivel])
  @@index([porcentaje])
  @@index([updatedAt])
}

model CalendarioEscolar {
  id             Int      @id @default(autoincrement())
  colegioId      String   @default("SANTA_RITA_001")
  fechaInicio    DateTime @db.Date
  fechaFin       DateTime @db.Date
  tipo           String
  descripcion    String   @default("")
  todosLosTurnos Boolean  @default(true)
  turnoId        Int?
  estado         Boolean  @default(true)
  createdAt      DateTime @default(now())

  colegio Colegio @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)
  turno   Turno?  @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  @@index([colegioId])
  @@index([fechaInicio, fechaFin])
  @@index([turnoId])
  @@index([estado])
}

model HistorialReporteAutomatico {
  id           Int       @id @default(autoincrement())
  colegioId    String    @default("SANTA_RITA_001")
  tipo         String
  destinatario String
  chatId       String    @default("")
  estudianteId Int?
  fechaInicio  DateTime?
  fechaFin     DateTime?
  estado       String
  detalle      String    @default("")
  createdAt    DateTime  @default(now())

  colegio    Colegio     @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)
  estudiante Estudiante? @relation(fields: [estudianteId], references: [id], onDelete: SetNull)

  @@index([colegioId])
  @@index([tipo])
  @@index([estado])
  @@index([createdAt])
  @@index([estudianteId])
}

model BiometriaFacial {
  id                    Int      @id @default(autoincrement())
  estudianteId          Int      @unique
  proveedor             String   @default("AWS_REKOGNITION")
  collectionId          String
  externalImageId       String   @unique
  estado                Boolean  @default(true)
  ultimaActualizacionAt DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  estudiante Estudiante     @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  rostros    RostroFacial[]

  @@index([estado])
  @@index([collectionId])
  @@index([proveedor])
}

model RostroFacial {
  id          Int      @id @default(autoincrement())
  biometriaId Int
  faceId      String   @unique
  imageId     String?
  confianza   Float?
  createdAt   DateTime @default(now())

  biometria BiometriaFacial @relation(fields: [biometriaId], references: [id], onDelete: Cascade)

  @@index([biometriaId])
  @@index([createdAt])
}

model CodigoFamiliar {
  id                  Int          @id @default(autoincrement())
  colegioId           String       @default("SANTA_RITA_001")
  codigo              String
  tutorTitular        String       @default("")
  telefonoContacto    String       @default("")
  correoContacto      String       @default("")
  passwordHash        String?
  dniTutor            String?
  intentosFallidos    Int          @default(0)
  bloqueadoHasta      DateTime?
  hermanosConfirmados Boolean      @default(false)
  estado              Boolean      @default(true)
  ultimoIngresoAt     DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  colegio     Colegio      @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)
  estudiantes Estudiante[]

  @@unique([colegioId, codigo])
  @@index([colegioId])
  @@index([codigo])
  @@index([estado])
}

model SistemaControl {
  id                         Int       @id @default(autoincrement())
  colegioId                  String    @unique @default("SANTA_RITA_001")
  motorActivo                Boolean   @default(false)
  asistenciaActivo           Boolean   @default(false)
  portalActivo               Boolean   @default(false)
  telegramActivo             Boolean   @default(false)
  whatsappActivo             Boolean   @default(false)
  reportesActivo             Boolean   @default(false)
  iaActivo                   Boolean   @default(false)
  alertasActivo              Boolean   @default(false)
  fotosActivo                Boolean   @default(false)
  estadoJornada              String    @default("CERRADO")
  modoOperacion              String    @default("MANUAL")
  horaAperturaJornada        String?   @default("06:30")
  horaCierreJornada          String?   @default("14:30")
  minutosAnticipacionEntrada Int       @default(60)
  minutosCierreAutomatico    Int       @default(30)
  ultimaActivacion           DateTime?
  ultimoUsuario              String    @default("SISTEMA")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  @@index([colegioId])
  @@index([motorActivo])
  @@index([modoOperacion])
}

model SystemHealthLog {
  id              Int      @id @default(autoincrement())
  colegioId       String   @default("SANTA_RITA_001")
  servicio        String   // "DATABASE" | "SUPERMOTOR" | "CRON" | "TELEGRAM" | "WHATSAPP" | "STORAGE"
  estado          String   // "OK" | "WARNING" | "ERROR"
  mensaje         String   @default("")
  tiempoRespuesta Int?     @default(0)
  detalles        String?  @default("")
  fechaHora       DateTime @default(now())

  colegio Colegio @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  @@index([colegioId])
  @@index([servicio])
  @@index([estado])
  @@index([fechaHora])
}

model Terminal {
  id             Int       @id @default(autoincrement())
  terminalId     String    @unique
  nombre         String
  colegioId      String    @default("SANTA_RITA_001")
  tokenHash      String
  estado         String    @default("ACTIVA") // "ACTIVA" | "INACTIVA" | "REVOCADA"
  ultimaConexion DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  @@index([colegioId])
  @@index([terminalId])
  @@index([estado])
}

model SalidaExcepcional {
  id              Int      @id @default(autoincrement())
  colegioId       String   @default("SANTA_RITA_001")
  asistenciaId    Int      @unique
  estudianteId    Int
  fecha           DateTime @default(now())
  fechaDia        String
  horaSalida      DateTime
  motivo          String   // "PROBLEMA_SALUD" | "ACCIDENTE_ESCOLAR" | "CITA_MEDICA" | "EMERGENCIA_FAMILIAR" | "RETIRO_AUTORIZADO" | "OTRO"
  motivoDetalle   String?  // Especificación si motivo == "OTRO"
  observacion     String   @db.Text
  usuarioRegistro String   // Usuario admin/personal que autorizó
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asistencia Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  colegio    Colegio    @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  @@index([colegioId])
  @@index([estudianteId])
  @@index([fechaDia])
  @@index([motivo])
  @@index([usuarioRegistro])
}

enum TipoEvidencia {
  ENTRADA
  SALIDA
}

enum EstadoEvidencia {
  PENDIENTE
  SUBIENDO
  COMPLETADA
  ERROR
  ERROR_FINAL
}

model EvidenciaFotografica {
  id            Int             @id @default(autoincrement())
  colegioId     String          @default("SANTA_RITA_001")
  asistenciaId  Int
  estudianteId  Int
  tipo          TipoEvidencia   @default(ENTRADA)
  estado        EstadoEvidencia @default(PENDIENTE)
  url           String?
  intentos      Int             @default(0)
  ultimoIntento DateTime?
  errorDetalle  String?
  tamanoBytes   Int?
  mimeType      String?
  esActiva      Boolean         @default(true)
  esProtegida   Boolean         @default(false)
  rotadaAt      DateTime?
  eliminadaBlobAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  asistencia Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  colegio    Colegio    @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  @@unique([asistenciaId, tipo])
  @@index([colegioId, estado])
  @@index([asistenciaId])
  @@index([estudianteId])
  @@index([createdAt])
  @@index([estudianteId, esActiva])
  @@index([esProtegida])
}

model FotoActivaEstudiante {
  id           Int           @id @default(autoincrement())
  colegioId    String        @default("SANTA_RITA_001")
  estudianteId Int
  turnoId      Int?
  asistenciaId Int
  fechaDia     String
  tipo         TipoEvidencia @default(ENTRADA)
  evidenciaId  Int?
  url          String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  colegio    Colegio    @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  turno      Turno?     @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  asistencia Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, turnoId, tipo])
  @@index([colegioId])
  @@index([asistenciaId])
  @@index([fechaDia])
}

model ColaLimpiezaBlob {
  id           Int           @id @default(autoincrement())
  colegioId    String        @default("SANTA_RITA_001")
  evidenciaId  Int?
  url          String
  tipo         TipoEvidencia @default(ENTRADA)
  estudianteId Int?
  asistenciaId Int?
  motivo       String        // "ROTACION_HABITUAL" | "LIMPIEZA_PROGRAMADA" | "ERROR_SUBIDA"
  estado       String        @default("CONSERVADO_POLITICA") // "CONSERVADO_POLITICA" | "PENDIENTE" | "ELIMINADO" | "ERROR"
  intentos     Int           @default(0)
  ultimoError  String?
  ejecutadoAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [codigo], onDelete: Cascade)

  @@index([estado])
  @@index([colegioId])
  @@index([createdAt])
}

model RegistroIdempotencia {
  id            Int      @id @default(autoincrement())
  clave         String   @unique
  tipoOperacion String   @default("ASISTENCIA")
  estudianteId  Int?
  colegioId     String   @default("SANTA_RITA_001")
  statusCode    Int
  respuesta     Json
  createdAt     DateTime @default(now())
  expiraAt      DateTime

  @@index([clave])
  @@index([expiraAt])
  @@index([estudianteId, createdAt])
}
